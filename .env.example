# 1. Create .env.example with placeholders (no real secrets)
cat > .env.example << 'EOF'
# ─────────────────────────────────────────────────────────────
# LAYA + GROQ ALERT TRIAGE SYSTEM — ENVIRONMENT TEMPLATE
# ─────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in your real values:
#     cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Groq (free LLM fallback) ──────────────────────────────────
# Get your free key at https://console.groq.com
GROQ_API_KEY=gsk_replace_me_with_your_real_key
GROQ_MODEL=llama-3.3-70b-versatile

# ── Laya (local decision layer — NO API KEY needed) ──────────
LAYA_CHECKPOINT=convaiinnovations/laya
LAYA_DEVICE=cpu

# ── Confidence guardrail ─────────────────────────────────────
CONFIDENCE_THRESHOLD=0.75
EOF
